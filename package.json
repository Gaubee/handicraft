{
  "name": "handicraft-backend-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @handicraft/daemon dev",
    "start": "pnpm --filter @handicraft/daemon start",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "smoke:engine": "pnpm --filter @handicraft/daemon smoke:engine",
    "e2e:smoke": "pnpm --filter @handicraft/daemon test:e2e"
  }
}
